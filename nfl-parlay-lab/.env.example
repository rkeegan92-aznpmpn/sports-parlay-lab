# Optional independent fanduelapi.com REST provider (Bearer key). Free tier delayed five minutes.
# On-demand only; never use NEXT_PUBLIC_ for this secret.
FANDUEL_API_KEY=
# REQUIRED for live odds. Get a key at https://the-odds-api.com (player props need a paid plan; check their pricing page).
ODDS_API_KEY=
# Optional tuning (cached live data is refreshed after this many minutes)
ODDS_CACHE_MIN=30
# nflverse player-stat CSV cache lifetime (hours)
NFL_STATS_CACHE_HOURS=24
# Injury reports change more frequently than historical stats
NFL_INJURIES_CACHE_MIN=60
# ESPN current roster cache lifetime (minutes)
NFL_ROSTER_CACHE_MIN=60
# Optional: override nflverse CSV URLs. {season} is replaced; default downloads use compressed GitHub release assets. No key needed.
NFL_STATS_URL=https://github.com/nflverse/nflverse-data/releases/download/stats_player/stats_player_week_{season}.csv
NFL_INJURIES_URL=https://github.com/nflverse/nflverse-data/releases/download/injuries/injuries_{season}.csv
# Optional override for the real schedule used to join weekly player rows to game IDs/dates.
# NFL_SCHEDULE_URL=https://raw.githubusercontent.com/nflverse/nfldata/master/data/games.csv
# SQLite file path (local). For serverless hosting use a hosted DB, see README.
DB_PATH=./data/parlay.db
# Set to 1 on a persistent-disk host; DB_PATH must be absolute and on the mounted disk.
REQUIRE_PERSISTENT_DB=0
# Current-season results and ESPN game logs/final summaries refresh more often than old history.
NFL_RESULTS_CACHE_MIN=15
# npm run dev/start automatically supervise one collector for this database while the app is alive.
# Set to 0 only when you intentionally use a separate collector on the same persistent database.
COLLECTOR_ENABLED=1

# With exhausted odds credits, run the collector without paid quote collection.
# COLLECTOR_MODE=settle-only
